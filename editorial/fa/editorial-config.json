{
  "version": "5.0.0",
  "default_content_paths": [
    "**/*.md",
    "**/*.mdx",
    "**/*.txt",
    "**/*.yaml",
    "**/*.yml",
    "**/*.json"
  ],
  "exclude_paths": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    "build/**",
    ".output/**",
    ".nuxt/**",
    ".pnpm-store/**",
    ".velite/**",
    "coverage/**",
    "public/**",
    "package.json",
    "pnpm-lock.yaml",
    "*/editorial-config.json",
    "editorial/fa/evaluation/**",
    ".editorial-engine-backups/**",
    "persian-editorial-engine-v*/**",
    "editorial/fa/core.md",
    "editorial/fa/profiles/ali/**"
  ],
  "forbidden_phrases": [
    "در دنیای امروز",
    "در عصر دیجیتال",
    "با پیشرفت روزافزون فناوری",
    "در این مقاله قصد داریم",
    "شایان ذکر است",
    "لازم به ذکر است",
    "راهکاری نوآورانه و انقلابی",
    "تجربه‌ای بی‌نظیر",
    "تحولی شگرف",
    "گامی بزرگ در راستای",
    "با افتخار اعلام می‌کنیم",
    "همه‌چیز را تغییر می‌دهد"
  ],
  "suspicious_phrases": [
    "بدون شک",
    "بی‌شک",
    "بهترین",
    "کامل‌ترین",
    "بی‌رقیب",
    "راهکار جامع",
    "نسل آینده",
    "فوق‌امن",
    "کاملاً مقیاس‌پذیر",
    "production-ready",
    "آماده‌ی production",
    "صددرصد",
    "همیشه",
    "هرگز"
  ],
  "high_risk_claims": [
    "غیرقابل هک",
    "امنیت صددرصد",
    "ناشناس مطلق",
    "ناشناسی کامل",
    "کاملاً غیرقابل ردیابی",
    "هیچ داده‌ای ذخیره نمی‌شود",
    "رمزنگاری سرتاسری",
    "end-to-end encrypted"
  ],
  "arabic_characters": {
    "ي": "ی",
    "ك": "ک"
  },
  "max_paragraph_chars_warning": 1000,
  "max_heading_depth": 4,
  "max_consecutive_blank_lines": 2,
  "allowed_suppressions": [
    "editorial-lint-disable-next-line",
    "editorial-lint-disable-file"
  ],
  "calques": [
    {
      "pattern": "(?<![ء-يپچژکگی‌])توسط(?![ء-يپچژکگی])",
      "hint": "مجهولِ ترجمه‌ای؛ کننده را فاعل جمله کن: «X را Y ساخت»."
    },
    {
      "pattern": "مورد (استفاده|بررسی|توجه|تأیید|قبول|حمایت|نیاز) قرار",
      "hint": "فعل ساده: «استفاده کرد»، «بررسی شد»."
    },
    {
      "pattern": "(?<![ء-يپچژکگی‌])(می‌باشد|می‌باشند|میباشد|می باشد)",
      "hint": "«است» / «هستند»."
    },
    {
      "pattern": "(?<![ء-يپچژکگی‌])(نمودن|نموده|نمودم|نمود|نماید|نمایید|نمایند)(?![ء-يپچژکگی])",
      "hint": "«کردن» و صرف‌هایش."
    },
    {
      "pattern": "اقدام به",
      "hint": "فعل اصلی را مستقیم بیاور: «اقدام به نصب کرد» ← «نصب کرد»."
    },
    {
      "pattern": "صورت (گرفت|گرفته|می‌گیرد|بگیرد|پذیرفت|می‌پذیرد)",
      "hint": "فعل اصلی را بیاور: «بررسی صورت گرفت» ← «بررسی کردم»."
    },
    {
      "pattern": "به منظور|در راستای",
      "hint": "«برای»."
    },
    {
      "pattern": "(?<![ء-يپچژکگی‌])بر روی(?![ء-يپچژکگی])",
      "hint": "«روی»."
    },
    {
      "pattern": "(?<![ء-يپچژکگی‌])قادر (به|است|هستند|خواهد|نیست|نبود)",
      "hint": "«می‌تواند» / «نمی‌تواند»."
    },
    {
      "pattern": "دارای (قابلیت|امکان|توانایی)",
      "hint": "فعل مستقیم: «سیستم X را انجام می‌دهد»."
    },
    {
      "pattern": "در حال حاضر",
      "hint": "اگر زمان واقعاً مهم است تاریخ بده؛ وگرنه حذف کن."
    },
    {
      "pattern": "این امر",
      "hint": "به مرجع مشخص اشاره کن: «این تغییر»، «این تصمیم»."
    }
  ]
}
